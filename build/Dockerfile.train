# Set Base Image
FROM python:3.11.13-bookworm

# Set WORKDIR
WORKDIR /app

# COPY and install requirements
COPY ./build/requirements_train.txt ./build/requirements_train.txt
RUN pip install --no-cache-dir -r ./build/requirements_train.txt

# COPY files
COPY ./src/train.py ./src/train.py

# Define entrypoint
CMD ["python","src/train.py"]
