# Set Base Image
FROM python:3.11.13-bookworm

# Set WORKDIR
WORKDIR /app

# COPY and install requirements
COPY build/requirements_train.txt /app/build/requirements_train.txt
RUN pip install --no-cache-dir -r /app/build/requirements_train.txt

# COPY files
COPY src/train.py /app/src/train.py

# Define entrypoint
CMD ["python", "-O", "src/train.py", "data/BENv2.lmdb/", "data/metadata.parquet", "data/metadata_for_patches_with_snow_cloud_or_shadow.parquet", "models/"]
